{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameWorkSpace",
  "version": "2.0.0",
  "identifier": "com.gameworkspace.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GameWorkSpace",
        "dragDropEnabled": false,
        "width": 1400,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' mino-asset: http://mino-asset.localhost https: blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
